---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Wedding of Ardi & Dila",
  description = "Wattuna mi kami mode multiplater 🧑🏻‍🤝‍👩🏻, oiya ki buka ki undangannya nah, datang ki juga di hari H biar ada yang bantu habisi makanan"
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-couple.jpg" />
    <meta property="og:type" content="website" />

    <!-- Self-hosted font preloads for performance -->
    <link rel="preload" href="/fonts/DMSerifDisplay-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Inter-Latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-white text-[#1f1c1b] font-sans antialiased overflow-x-hidden selection:bg-[#fee2e6] selection:text-[#6e2736]">
    <div class="relative min-h-screen">
      <slot />
    </div>
  </body>
</html>
